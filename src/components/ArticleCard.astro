---
import type { CollectionEntry } from 'astro:content';
import { getCategory } from '../config/categories';
import { articleUrl } from '../utils/urls';
import { estimateReadingTime } from '../utils/readingTime';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const category = getCategory(article.data.category);
const readingTime = estimateReadingTime(article.body ?? '');
---

<a href={articleUrl(article)} class="article-card">
  <div class="media-placeholder card-media" aria-hidden="true">
    {article.data.heroImage ? (
      <img
        src={article.data.heroImage}
        alt={article.data.heroImageAlt ?? ''}
        width="640"
        height="480"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span>{category?.name ?? 'Japan'}</span>
    )}
  </div>
  <div class="card-body">
    {category && <p class="card-category">{category.name}</p>}
    <h3>{article.data.title}</h3>
    <p class="card-description">{article.data.description}</p>
    <p class="card-meta">{readingTime}</p>
  </div>
</a>

<style>
  .article-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--color-text);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }

  .article-card:hover {
    text-decoration: none;
    box-shadow: var(--shadow-medium);
    transform: translateY(-2px);
  }

  .card-media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    padding: 0;
  }

  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-body {
    padding: var(--space-2) var(--space-3) var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .card-category {
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent);
    margin: 0;
  }

  .card-body h3 {
    font-size: 1.15rem;
    margin-bottom: 0.15rem;
  }

  .card-description {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    margin-bottom: 0;
  }

  .card-meta {
    color: var(--color-text-muted);
    font-size: 0.8rem;
    margin: 0.3rem 0 0;
  }
</style>

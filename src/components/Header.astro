---
import { categories } from '../config/categories';
import { siteConfig } from '../config/site';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">{siteConfig.shortTitle}</a>

    <details class="nav-toggle">
      <summary aria-label="Menu">
        <span class="nav-toggle-label">Menu</span>
      </summary>
      <nav class="main-nav" aria-label="Categories">
        <ul>
          {categories.map((cat) => (
            <li><a href={`/${cat.slug}/`}>{cat.name}</a></li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 20;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-2);
  }

  .logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .logo:hover {
    text-decoration: none;
    color: var(--color-accent);
  }

  /* デフォルト（モバイル）: details/summaryでJS無しの開閉メニュー */
  .nav-toggle summary {
    cursor: pointer;
    list-style: none;
    font-weight: 600;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
  }

  .nav-toggle summary::-webkit-details-marker {
    display: none;
  }

  .nav-toggle summary::after {
    content: '▾';
    margin-left: 0.4rem;
  }

  .nav-toggle[open] summary::after {
    content: '▴';
  }

  .main-nav {
    position: absolute;
    right: var(--space-3);
    margin-top: 0.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-medium);
    padding: var(--space-2);
  }

  .main-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 180px;
  }

  .main-nav a {
    display: block;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius);
    color: var(--color-text);
    font-weight: 500;
  }

  .main-nav a:hover {
    background: var(--color-bg-alt);
    text-decoration: none;
  }

  /* デスクトップ: 常時展開の横並びナビにする */
  @media (min-width: 760px) {
    .nav-toggle summary {
      display: none;
    }

    .main-nav {
      position: static;
      background: none;
      border: none;
      box-shadow: none;
      padding: 0;
      margin-top: 0;
    }

    .main-nav ul {
      flex-direction: row;
      gap: var(--space-3);
      min-width: 0;
    }

    .main-nav a {
      padding: 0.25rem 0;
    }
  }
</style>

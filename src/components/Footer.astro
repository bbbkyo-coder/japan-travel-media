---
import { categories } from '../config/categories';
import { siteConfig } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-col">
      <p class="footer-logo">{siteConfig.shortTitle}</p>
      <p class="footer-tagline">{siteConfig.description}</p>
    </div>

    <nav class="footer-col" aria-label="Categories">
      <p class="footer-heading">Explore</p>
      <ul>
        {categories.map((cat) => (
          <li><a href={`/${cat.slug}/`}>{cat.name}</a></li>
        ))}
      </ul>
    </nav>

    <nav class="footer-col" aria-label="Site">
      <p class="footer-heading">Site</p>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/affiliate-disclosure/">Affiliate Disclosure</a></li>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms &amp; Disclaimer</a></li>
      </ul>
    </nav>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} {siteConfig.shortTitle}. All rights reserved.</p>
    <p class="footer-disclosure">
      Some links on this site are affiliate links. See our
      <a href="/affiliate-disclosure/">Affiliate Disclosure</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-alt);
    border-top: 1px solid var(--color-border);
    margin-top: var(--space-6);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-4);
    padding-block: var(--space-5);
  }

  .footer-logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .footer-tagline {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    max-width: 32ch;
  }

  .footer-heading {
    font-weight: 600;
    margin-bottom: 0.6rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    font-size: 0.78rem;
    letter-spacing: 0.06em;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer-col a {
    color: var(--color-text);
    font-size: 0.92rem;
  }

  .footer-bottom {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: space-between;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }
</style>

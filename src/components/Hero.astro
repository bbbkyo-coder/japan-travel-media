---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: string;
  imageAlt?: string;
  size?: 'large' | 'medium';
}

const { eyebrow, title, subtitle, image, imageAlt = '', size = 'medium' } = Astro.props;
---

<section class={`hero hero-${size}`}>
  <div class="hero-media">
    {image ? (
      <img src={image} alt={imageAlt} width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
    ) : (
      <div class="media-placeholder hero-placeholder" role="img" aria-label={imageAlt || title}></div>
    )}
  </div>
  <div class="container hero-content">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {subtitle && <p class="hero-subtitle">{subtitle}</p>}
    <slot />
  </div>
</section>

<style>
  .hero {
    position: relative;
    color: var(--color-text-inverse);
    display: flex;
    align-items: flex-end;
  }

  .hero-large {
    min-height: 60vh;
  }

  .hero-medium {
    min-height: 34vh;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(28, 27, 26, 0.15) 0%, rgba(28, 27, 26, 0.75) 100%);
  }

  .hero-media .media-placeholder {
    height: 100%;
    color: var(--color-text-inverse);
    background: linear-gradient(135deg, var(--color-indigo) 0%, var(--color-text) 100%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-block: var(--space-5) var(--space-4);
  }

  .hero-content .eyebrow {
    color: var(--color-text-inverse);
    opacity: 0.85;
  }

  .hero-content h1 {
    color: var(--color-text-inverse);
    max-width: 20ch;
  }

  .hero-subtitle {
    max-width: 56ch;
    font-size: 1.1rem;
    opacity: 0.92;
  }
</style>

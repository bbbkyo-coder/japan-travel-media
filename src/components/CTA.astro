---
interface Props {
  heading: string;
  body?: string;
  ctaLabel: string;
  ctaHref: string;
  variant?: 'primary' | 'secondary';
  compact?: boolean;
}

const { heading, body, ctaLabel, ctaHref, variant = 'primary', compact = false } = Astro.props;
const isExternal = /^https?:\/\//.test(ctaHref);
---

<div class={`cta cta-${variant} ${compact ? 'cta-compact' : ''}`}>
  <div class="cta-text">
    <p class="cta-heading">{heading}</p>
    {body && <p class="cta-body">{body}</p>}
  </div>
  <a
    href={ctaHref}
    class={`btn ${variant === 'primary' ? 'btn-primary' : 'btn-secondary'}`}
    {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer sponsored' } : {})}
  >
    {ctaLabel}
  </a>
</div>

<style>
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
  }

  .cta-primary {
    background: var(--color-indigo-soft);
    border-color: var(--color-indigo);
  }

  .cta-compact {
    padding: var(--space-2);
  }

  .cta-heading {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.05rem;
    margin: 0 0 0.2rem;
  }

  .cta-body {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    margin: 0;
    max-width: 48ch;
  }

  .cta-text {
    flex: 1 1 260px;
  }
</style>

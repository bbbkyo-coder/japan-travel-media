---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const entry = await getEntry('pages', 'contact');
if (!entry) throw new Error('Missing content/pages/contact.md');
const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} description={entry.data.description} path="/contact/" updatedDate={entry.data.updatedDate}>
  <Content />
</PageLayout>

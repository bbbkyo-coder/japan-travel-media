{
  // Cloudflare Workers への静的サイトデプロイ設定。
  // 2026年時点でCloudflareは新規プロジェクトにPagesではなくWorkersを推奨しており、
  // @astrojs/cloudflare アダプターも不要（完全な静的サイトのため）。
  // デプロイ手順は README.md を参照。
  "name": "japan-travel-media",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
